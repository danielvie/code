// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // Global / Workspace
  {
    "context": "Workspace",
    "bindings": {
      "alt-x": "pane::CloseActiveItem",
      "alt-b": "workspace::ToggleLeftDock",
      "alt-n": "workspace::ToggleRightDock",
      "ctrl-p": null,
      "alt-p": "file_finder::Toggle",
    },
  },
  {
    "bindings": {
      "ctrl-shift-i": null,
      "ctrl-shift-u": "agent::AddSelectionToThread"
    },
  },

  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-p": "projects::OpenRecent",
    },
  },
  {
    "context": "((VimControl && !menu) || (!Editor && !Terminal))",
    "bindings": {
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "j": ["vim::Down", { "display_lines": true }],
      "k": ["vim::Up", { "display_lines": true }],
    },
  },
  {
    "context": "!Editor && !Terminal",
    "bindings": {
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
    },
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
    },
  },

  // Vim Normal Mode
  {
    "context": "Editor && vim_mode == normal && !VimWaiting",
    "bindings": {
      ", v": ["task::Spawn", { "task_name": "run in terminal" }],
      ", k s": "zed::OpenKeymap",
      "alt-|": "pane::JoinIntoNext",
      ", enter": "editor::SelectLargerSyntaxNode",
      ", w": "workspace::SaveWithoutFormat",
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
      "ctrl-alt-h": "pane::SwapItemLeft",
      "ctrl-alt-l": "pane::SwapItemRight",
      "shift-r": "editor::ToggleFold",
      "z m": "editor::FoldAll",
      "z r": "editor::UnfoldAll",
      "z c": "editor::FoldRecursive",
      "z o": "editor::UnfoldRecursive",
      "alt-t": "editor::SelectAll",
      "shift-q": ["vim::SelectRegister", "q"],
      "shift-w": ["vim::SelectRegister", "w"],
      "shift-e": ["vim::SelectRegister", "e"],
    },
  },
  
  // Select Larger Node
  {
      "context": "Editor && vim_mode == normal && !VimWaiting",
      "bindings": {
        "alt-,": "editor::SelectLargerSyntaxNode",
      },
  },
  {
      "context": "Editor && vim_mode == visual && !VimWaiting",
      "bindings": {
        "alt-,": "editor::SelectLargerSyntaxNode",
        "alt-.": "editor::SelectSmallerSyntaxNode",
      },
  },
  
  // Vim Visual Mode
  {
    "context": "Editor && vim_mode == visual && !VimWaiting",
    "bindings": {
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",
      "shift-s": "vim::PushAddSurrounds",
      "shift-r": "editor::ToggleFold",
    },
  },

  // Vim Combined (Normal & Visual)
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      ", s n": "editor::ConvertToSnakeCase",
      "shift-x": "vim::Exchange"
    },
  },
  
  // Vim Sneak
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      // "s": "vim::JumpToWord",
      // "s": "vim::PushSneak",
      "s": "vim::HelixJumpToWord"
    },
  },
  {
    "context": "Editor && vim_mode == normal && !VimWaiting",
    "bindings": {
      "S": "vim::PushSneakBackward",
    },
  },
  
  // Vim Operator Mode
  {
    "context": "Editor && vim_mode == operator && !VimWaiting",
    "bindings": {
      "shift-l": "vim::EndOfLine",
      "shift-h": "vim::FirstNonWhitespace",
    },
  },

  // Vim Control (General)
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      "alt-d": "vim::SelectNext",
    },
  },

  // Editor (General)
  {
    "context": "Editor && !VimWaiting",
    "bindings": {
      "ctrl-shift-i": "assistant::InlineAssist",
    },
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "ctrl-y": "editor::ConfirmCompletion",
    },
  },

  // Navigation & Panes (Global/Shared)
  {
      "context": "Workspace",
      "bindings": {
        "ctrl-b k": "workspace::ActivatePaneUp",
        "ctrl-b j": "workspace::ActivatePaneDown",
        "ctrl-b h": "workspace::ActivatePaneLeft",
        "ctrl-b l": "workspace::ActivatePaneRight",
      },
  },
  {
    "context": "(Editor && vim_mode == normal) || Terminal",
    "bindings": {
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",

      "ctrl-b v": "pane::SplitAndMoveRight",
      "ctrl-b -": "pane::SplitAndMoveDown",
    },
  },
  
  // Terminal
  {
    "context": "Terminal",
    "bindings": {
      "alt-h": "pane::ActivatePreviousItem",
      "alt-l": "pane::ActivateNextItem",
      "alt-b": "workspace::ToggleLeftDock",
      "shift-down": "pane::ActivatePreviousItem",
      "shift-up": "pane::ActivateNextItem",
    },
  },

  // Project Panel
  {
    "context": "(ProjectPanel && not_editing)",
    "bindings": {
      "a": "project_panel::NewFile",
      "d": "project_panel::Delete",
      "r": "project_panel::Rename",
      "o": "project_panel::OpenPermanent",
      "s": "workspace::NewFileSplitHorizontal",
    },
  },
  {
    "context": "vim_mode == waiting",
    "unbind": {
      "ctrl-v": [
        "vim::PushLiteral",
        {}
      ]
    }
  },
  {
    "context": "vim_mode == replace",
    "unbind": {
      "ctrl-v": [
        "vim::PushLiteral",
        {}
      ]
    }
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-v": [
        "vim::Literal",
        [
          "ctrl-v",
          "\u0016"
        ]
      ]
    }
  },
  {
    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-v": [
        "vim::PushLiteral",
        {}
      ]
    }
  },
  {
    "context": "FileFinder || FileFinder > Picker > Editor || FileFinder > Picker > menu",
    "unbind": {
      "ctrl-j": "pane::SplitDown"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-j": "workspace::ToggleBottomDock"
    }
  },
  {
    "context": "vim_mode == literal",
    "unbind": {
      "ctrl-x": [
        "vim::Literal",
        [
          "ctrl-x",
          "\u0018"
        ]
      ]
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-x": "editor::Cut"
    }
  },
]