{
  "manifest_version": 3,
  "name": "Lesson video saver",
  "version": "0.3.0",
  "description": "Find exposed video files in the current Delligatti lesson and save them to your computer.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "lesson-video-saver@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  },
  "permissions": ["activeTab", "scripting", "storage", "downloads", "webRequest", "webNavigation"],
  "host_permissions": ["https://learn.delligattiassociates.com/*", "https://player.vimeo.com/*", "https://*.vimeocdn.com/*", "https://*.akamaized.net/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Find lesson videos",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}
}
